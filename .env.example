# BOT Mainnet P0 configuration.
# Copy this file to `.env` locally and fill in values. Never commit `.env`.

# Builder/deployer wallet private key.
# SERVER-ONLY. Never reference via NEXT_PUBLIC_*. Leave empty for doctor runs
# without a wallet (reports "BUILDER WALLET: NOT CONFIGURED").
BOT_BUILDER_PRIVATE_KEY=

# Optional override of the official Mainnet RPC (defaults to https://rpc.botchain.ai).
BOT_MAINNET_RPC_URL=

# Opt-in Mainnet write proof. Set to "true" ONLY when you explicitly authorize
# a tiny transaction. Default is disabled.
P0_ENABLE_MAINNET_WRITE=false

# Tiny write-proof amount in BOT units (refused if >= 1).
P0_WRITE_AMOUNT=0.0001

# Write-proof token: "BOT" (default) or "USDT" (only allowed if settlement token is VERIFIED).
P0_WRITE_TOKEN=BOT

# Testnet staging wallet (server-only). Never referenced via NEXT_PUBLIC_*.
# Testnet scripts never fall back to BOT_BUILDER_PRIVATE_KEY.
BOT_TESTNET_PRIVATE_KEY=

# Optional override of the official Testnet RPC (defaults to https://rpc.bohr.life).
BOT_TESTNET_RPC_URL=

# Opt-in Testnet write proof. Set to "true" ONLY when you explicitly authorize
# a tiny tBOT transaction on Testnet (chain 968). Default is disabled.
P0_ENABLE_TESTNET_WRITE=false

# Tiny testnet write-proof amount in tBOT units (refused if >= 1).
P0_TESTNET_WRITE_AMOUNT=0.0001

# Optional: a block number confirmed via the explorer (e.g., the faucet funding
# block). The doctor prints a floor check against this. Never required by logic.
BOT_TESTNET_KNOWN_BLOCK=

# Frontend environment (optional). Only "testnet" is accepted in P1.
# Missing, invalid, or an explicit "mainnet" value fails closed to testnet.
NEXT_PUBLIC_NOSTOS_ENV=testnet